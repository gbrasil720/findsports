# Valores FAKE para a suíte de testes (WEB-24). Nunca coloque segredos reais aqui.
# Carregado por bunfig.toml → [test].preload → test-env.preload.ts, que roda antes
# de qualquer arquivo de teste. O `createEnv` de packages/env continua estrito.
NODE_ENV=test
DATABASE_URL=postgres://findsports_dev:findsports_dev_local@127.0.0.1:5432/findsports_dev
BETTER_AUTH_SECRET=test-only-secret-00000000000000000000000000
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
