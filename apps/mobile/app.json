{
  "expo": {
    "name": "Onside",
    "slug": "onside",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "onside",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sh.onside.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12120f",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sh.onside.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Onside usa sua localização para contar a distância até os bares com jogo perto de você. Ela não fica salva e nunca aparece para os bares.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#c9f135",
          "dark": {
            "backgroundColor": "#12120f"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A Onside usa a câmera para ler o código de amigo (QR) de outra pessoa e para tirar a sua foto do perfil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "A Onside procura na sua agenda quem já está no app. Os e-mails não saem do celular: só uma assinatura de cada um é comparada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Onside abre suas fotos só para você escolher a foto do perfil.",
          "cameraPermission": "A Onside usa a câmera para ler o código de amigo (QR) de outra pessoa e para tirar a sua foto do perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
