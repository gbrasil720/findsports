# Segredos do Worker onside-web (WEB-200). Em produção: `wrangler secret put <NOME>`.
# Localmente só valem para `wrangler dev` / `bun run preview:cf`: copie para
# `.dev.vars` (fora do git). O dev normal (`vite dev`) segue em Node e lê `.env`.
# Os `vars` não secretos estão em wrangler.jsonc; o banco vem do binding
# HYPERDRIVE (localConnectionString), não de DATABASE_URL.
BETTER_AUTH_SECRET=
RESEND_API_KEY=
LOCATIONIQ_API_KEY=
# Stripe (WEB-31): `sk_test_...` fora de produção — a chave viva é recusada
# fora do domínio onside.sh. O segredo do webhook sai do endpoint cadastrado
# no painel do Stripe (`/api/auth/stripe/webhook`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
# Opcional: sem ela o Turnstile não é verificado no servidor.
TURNSTILE_SECRET_KEY=
