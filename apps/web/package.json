{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:vercel": "if [ \"$VERCEL_ENV\" = production ]; then bun run --cwd ../.. db:migrate:deploy; fi && vite build && bun scripts/build-vercel.mjs",
    "build:cf": "vite build --mode cloudflare",
    "deploy:cf": "vite build --mode cloudflare && wrangler deploy",
    "preview:cf": "vite build --mode cloudflare && vite preview --mode cloudflare",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test --preload=../../test-env.preload.ts",
    "serve": "vite preview",
    "dev": "vite dev",
    "dev:load-test": "NODE_ENV=test LOAD_TEST_DATABASE_URL=postgres://findsports_load_test:findsports_load_test_local@localhost:5433/findsports_load_test vite dev --port 3101 --strictPort --host 0.0.0.0"
  },
  "dependencies": {
    "@dodopayments/better-auth": "^1.6.3",
    "@findsports_oficial/api": "workspace:*",
    "@findsports_oficial/auth": "workspace:*",
    "@findsports_oficial/config": "workspace:*",
    "@findsports_oficial/db": "workspace:*",
    "@findsports_oficial/ui": "workspace:*",
    "@protomaps/basemaps": "^5.7.2",
    "@t3-oss/env-core": "^0.13.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/form-core": "1.32.0",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "^11.16.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "catalog:",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.5.0",
    "posthog-js": "^1.387.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-qr-code": "2.0.18",
    "reicon-react": "^1.1.302",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "typescript": "catalog:",
    "vite": "^8.0.8",
    "wrangler": "4.147.0"
  }
}
