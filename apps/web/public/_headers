# Só os arquivos de public/ (Workers assets) passam por aqui. O que o Worker
# responde (SSR, /api) recebe o HSTS em src/worker.ts; hsts.test.ts mantém
# os dois valores iguais. Sem includeSubDomains: mail, media e tiles não
# passam por este Worker.
/*
  Strict-Transport-Security: max-age=63072000

# Fontes versionadas pela URL (`?v=N` em tokens.css e nos preloads). Sem isto o
# Workers assets manda `max-age=0, must-revalidate` e cada visita revalida.
# Trocou o arquivo, suba o `?v=` em todas as referências: o nome não muda.
/fonts/onside/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
