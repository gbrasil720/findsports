{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // WEB-199: app em Workers. Desde o corte (WEB-205) responde em
  // www.onside.sh; o apex redireciona para www por Redirect Rule da zona.
  "name": "onside-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // WEB-205: custom domain — a Cloudflare cria e mantém o registro de `www`.
  "routes": [{ "pattern": "www.onside.sh", "custom_domain": true }],
  // Fica para depuração, mas sem login: BETTER_AUTH_URL é o www.
  "workers_dev": true,
  // URL de versão usaria o banco e os segredos de produção (épico WEB-198,
  // risco 6). Preview por PR é outro Worker (WEB-204).
  "preview_urls": false,
  // Perto do Neon (aws-us-east-1). Sem isso o Worker roda perto do usuário e
  // cada query cruza São Paulo → Virgínia.
  "placement": { "region": "aws:us-east-1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // WEB-201: Neon pela conexão direta (sem -pooler), cache de query
  // DESLIGADO — ligado, o rate limit e a leitura logo após a escrita erram
  // em silêncio. Conferir com `wrangler hyperdrive get <id>`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a8e2a503b7fe4d9c837babf4f1259daa",
      "localConnectionString": "postgres://findsports_dev:findsports_dev_local@localhost:5432/findsports_dev"
    }
  ],
  // WEB-200: o que não é segredo. Segredos via `wrangler secret put`
  // (lista em .dev.vars.example). Nenhuma chave E2E_* aqui: o env recusa o
  // boot em produção com elas.
  //
  // WEB-205: as três URLs são o domínio público. O better-auth confia nessa
  // origem e na irmã sem www., e o cookie vale em onside.sh.
  // O workers.dev deixa de logar.
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://www.onside.sh",
    "CORS_ORIGIN": "https://www.onside.sh",
    "PUBLIC_APP_URL": "https://www.onside.sh",
    "RESEND_FROM_EMAIL": "contato@mail.onside.sh",
    "LAUNCH_ADMISSION_MODE": "invite-only",
    "CF_ACCOUNT_ID": "dc48dae1d364480e5b618e4a00e98565",
    "MEDIA_PUBLIC_ORIGIN": "https://media.onside.sh"
  },
  // WEB-203: retenção diária de analytics (scheduled() em src/worker.ts).
  // 04:00 UTC = 01:00 em São Paulo. É o único agendador. Para desligar,
  // volte para [] e faça deploy —
  // apagar a chave não remove o agendamento já publicado.
  "triggers": { "crons": ["0 4 * * *"] },

  // WEB-204: preview de PR, outro Worker com banco próprio (branch `preview`
  // do Neon). Uma URL só, a do último PR publicado: com ela no
  // BETTER_AUTH_URL o login funciona, o que uma URL por PR não deixaria.
  // Escolhido no build (`CLOUDFLARE_ENV=preview`), não no `wrangler deploy`.
  //
  // `vars` e `hyperdrive` não são herdados do topo: repita aqui o que entrar
  // lá. Sem CF_ACCOUNT_ID e sem as chaves R2: o bucket `onside-media` é fixo
  // no código, então o preview só lê as fotos (MEDIA_PUBLIC_ORIGIN) e o
  // upload fica desligado, com a mensagem própria.
  "env": {
    "preview": {
      "name": "onside-web-preview",
      // Sem cron e sem domínio no preview: `triggers` e `routes` são
      // herdados do topo, e herdar o www roubaria o domínio de produção.
      "triggers": { "crons": [] },
      "routes": [],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // `onside-db-preview`: branch `preview` do Neon, conexão direta,
          // --caching-disabled. Refresh do branch em AGENTS.md.
          "id": "42e0cde29503486988e18d65d37a3f50"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "BETTER_AUTH_URL": "https://onside-web-preview.dev-guilhermebrasil.workers.dev",
        "CORS_ORIGIN": "https://onside-web-preview.dev-guilhermebrasil.workers.dev",
        "PUBLIC_APP_URL": "https://onside-web-preview.dev-guilhermebrasil.workers.dev",
        "RESEND_FROM_EMAIL": "contato@mail.onside.sh",
        "LAUNCH_ADMISSION_MODE": "invite-only",
        "MEDIA_PUBLIC_ORIGIN": "https://media.onside.sh",
        // Banco com e-mails reais: e-mail vai para o log, com o link. O env
        // recusa isto com PUBLIC_APP_URL em onside.sh.
        "EMAIL_DELIVERY": "console",
        // NODE_ENV=production levaria a Dodo a live_mode; as chaves são de teste.
        "DODO_PAYMENTS_ENVIRONMENT": "test_mode"
      }
    }
  }
}
