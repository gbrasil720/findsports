{
  "extends": "@findsports_oficial/config/tsconfig.base.json",
  // O padrão (`**/*`) não inclui JSON, e projeto `composite` recusa importar
  // arquivo fora da lista: `src/data` entra à mão (WEB-319).
  "include": ["**/*", "src/data/*.json"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "composite": true,
    "types": ["node", "bun"]
  }
}
