{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DEV_DATABASE_URL",
    "LOAD_TEST_DATABASE_URL",
    "E2E_DATABASE_URL",
    "RUN_DISPOSABLE_DB_TESTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:load-test": {
      "cache": false,
      "persistent": true,
      "env": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "db:seed:analytics": {
      "cache": false,
      "env": ["NODE_ENV", "ANALYTICS_SEED_PUB_EMAIL"]
    },
    "db:seed:analytics:clean": {
      "cache": false,
      "env": ["NODE_ENV", "ANALYTICS_SEED_PUB_EMAIL"]
    },
    "db:seed:load-test": {
      "cache": false,
      "env": ["NODE_ENV", "LOAD_TEST_DATABASE_URL"]
    },
    "db:seed:sports": {
      "cache": false
    }
  }
}
