{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:load-test": {
      "cache": false,
      "persistent": true,
      "env": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "CORS_ORIGIN"]
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:seed:analytics": {
      "cache": false,
      "env": ["NODE_ENV", "ANALYTICS_SEED_PUB_EMAIL"]
    },
    "db:seed:analytics:clean": {
      "cache": false,
      "env": ["NODE_ENV", "ANALYTICS_SEED_PUB_EMAIL"]
    },
    "db:seed:load-test": {
      "cache": false,
      "env": ["NODE_ENV", "LOAD_TEST_DATABASE_URL"]
    },
    "db:seed:sports": {
      "cache": false
    },
    "db:seed:teams": {
      "cache": false
    }
  }
}
